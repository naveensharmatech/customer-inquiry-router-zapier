# Email Configuration
URGENT_EMAIL=urgent-team@your-company.com
SUPPORT_EMAIL=support@your-company.com
GENERAL_EMAIL=general@your-company.com
# Zapier Configuration
ZAPIER_ZAP_ID=377870671
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/YOUR_WEBHOOK_ID
# Classification Thresholds
URGENCY_THRESHOLD=7
ESCALATION_KEYWORDS=urgent,asap,emergency,critical,broken
SUPPORT_KEYWORDS=help,issue,problem,error
# Optional: HubSpot
HUBSPOT_API_KEY=your_hubspot_api_key_here
# Optional: Claude API
CLAUDE_API_KEY=your_claude_api_key_here
# Environment
NODE_ENV=production
DEBUG=false
