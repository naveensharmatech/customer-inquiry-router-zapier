# Zapier Configuration
ZAPIER_API_KEY=your_zapier_api_key_here

# Claude API Configuration (if using Claude API version)
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxx

# Gmail Configuration
GMAIL_FROM_ADDRESS=your-email@gmail.com

# HubSpot Configuration
HUBSPOT_API_KEY=your_hubspot_api_key_here
HUBSPOT_PORTAL_ID=your_hubspot_portal_id

# Email Classification Settings
EMAIL_PRIORITY_THRESHOLD_HIGH=0.8
EMAIL_PRIORITY_THRESHOLD_MEDIUM=0.5

# Response Settings
RESPONSE_TIMEOUT_MS=5000
MAX_RETRIES=3

# Logging
LOG_LEVEL=info
ENABLE_DETAILED_LOGS=false

# Environment
NODE_ENV=production
